# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/undercut

# Optional. Without it, briefs are written from a plain template instead of by Claude.
ANTHROPIC_API_KEY=

# Sent with every request so site owners can identify us.
UNDERCUT_USER_AGENT=UndercutBot/0.1 (+https://github.com/wolfkeymedia/undercut)
